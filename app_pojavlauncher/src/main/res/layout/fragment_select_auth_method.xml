<?xml version="1.0" encoding="utf-8"?>
<!-- Xion: choose how to play. Offline is first-class, no Microsoft account needed. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:paddingHorizontal="@dimen/_14sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:maxWidth="@dimen/_320sdp"
        android:background="@drawable/xion_glass"
        android:orientation="vertical"
        android:padding="@dimen/_18sdp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_medium"
            android:text="@string/xion_auth_title"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_20ssp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:text="@string/xion_auth_subtitle"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/_10ssp" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/button_local_authentication"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_46sdp"
            android:layout_marginTop="@dimen/_18sdp"
            android:text="@string/xion_auth_offline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:gravity="center"
            android:text="@string/xion_auth_offline_hint"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/_9ssp" />

        <Button
            android:id="@+id/button_microsoft_authentication"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_46sdp"
            android:layout_marginTop="@dimen/_14sdp"
            android:background="@drawable/xion_glass_pill"
            android:fontFamily="@font/inter_medium"
            android:stateListAnimator="@null"
            android:text="@string/xion_auth_microsoft"
            android:textAllCaps="false"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/_12ssp" />
    </LinearLayout>
</FrameLayout>
